APP_NAME=LagosPanel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://painel.exemplo.com
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
HASH_DRIVER=argon2id
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=nao-responda@exemplo.com
MAIL_FROM_NAME=LagosPanel
PAYMENTS_LIVE=false
STRIPE_ENABLED=false
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
MP_ENABLED=false
MP_ACCESS_TOKEN=
EFI_ENABLED=false
EFI_ENVIRONMENT=homologacao
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_PATH=
EFI_CERTIFICATE_TYPE=PEM
EFI_PIX_KEY=
EFI_CHARGE_EXPIRATION=3600
# Para MariaDB/MySQL, DB_CONNECTION=mysql e configure host, usuário e senha.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=lagos
# DB_PASSWORD=

# Reserva de novos pedidos: 15 a 10080 minutos.
ORDER_RESERVATION_MINUTES=1440

# Quota de anexos de todos os chamados da conta: 10 a 1024 MiB.
SUPPORT_ATTACHMENT_ACCOUNT_MIB=50

# Bloqueio global de chamadas nativas. Habilite somente após preparar os servidores de homologação.
NATIVE_PROVISIONING_ENABLED=false

# Identificação exibida nas faturas em PDF (documentos não fiscais).
INVOICE_ISSUER_NAME=LagosPanel
INVOICE_ISSUER_DETAILS=

# Opcional: Ollama sem TLS SOMENTE em localhost/127.0.0.1/::1 do servidor.
OLLAMA_ALLOW_LOOPBACK_HTTP=false

# Saída assinada para destinos públicos cadastrados no ADM.
OUTGOING_WEBHOOKS_ENABLED=false

# Política inicial; pode ser ajustada em ADM > Configurações > Segurança.
LAGOS_REQUIRE_ADMIN_2FA=false
# Atualizações exigem worker dedicado não-root, configurado pelo operador.
PANEL_UPDATES_ENABLED=false
PANEL_UPDATES_COMPOSER=/usr/local/bin/composer
